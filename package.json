{
  "name": "dsh-pwsh-guard",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) plugin: reject shell text I/O - Select-String, Get-Content, findstr, rg, cat, node -e - in pwsh/bash/ops_bash, and point the agent at read/grep/glob.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/check.mjs",
    "prepare": "tsdown"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "tool-guard",
    "powershell",
    "coding-agent"
  ],
  "author": "Steven-Qiang <git@qiangmou.ren>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steven-Qiang/dsh-pwsh-guard.git"
  },
  "homepage": "https://github.com/Steven-Qiang/dsh-pwsh-guard#readme",
  "bugs": {
    "url": "https://github.com/Steven-Qiang/dsh-pwsh-guard/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
